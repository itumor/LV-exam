{
  "title": "lvcodex — AI cost & token telemetry",
  "uid": "lvcodex-ai-cost",
  "tags": ["lvcodex", "ai", "cost", "t027"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(lvcodex_ai_cost_cents_total, provider)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(lvcodex_ai_cost_cents_total{provider=~\"$provider\"}, model)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "AI cost (EUR/hour) by model",
      "description": "Hourly spend by (provider, model). Source: lvcodex_ai_cost_cents_total. Cents are divided by 100 to render EUR.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (provider, model) (rate(lvcodex_ai_cost_cents_total{provider=~\"$provider\",model=~\"$model\"}[5m])) * 3600 / 100",
          "legendFormat": "{{provider}} / {{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "min": 0
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "AI tokens per minute by direction",
      "description": "Tokens/minute split by input vs output. Source: lvcodex_ai_tokens_total.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum by (direction) (rate(lvcodex_ai_tokens_total{provider=~\"$provider\",model=~\"$model\"}[5m])) * 60",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Top models by 24h spend (EUR)",
      "description": "Models ranked by cumulative spend over the last 24h.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "topk(5, sum by (provider, model) (increase(lvcodex_ai_cost_cents_total{provider=~\"$provider\",model=~\"$model\"}[24h])) / 100)",
          "legendFormat": "{{provider}} / {{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "min": 0
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Spend (last 24h)",
      "description": "Cumulative AI spend over the last 24h in EUR.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "sum(increase(lvcodex_ai_cost_cents_total[24h])) / 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 20}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tokens (last 24h)",
      "description": "Total input + output tokens served over the last 24h.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 8},
      "targets": [
        {
          "expr": "sum(increase(lvcodex_ai_tokens_total[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Top models by tokens/min (input + output)",
      "description": "Per-model token throughput across both directions.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "topk(5, sum by (provider, model) (rate(lvcodex_ai_tokens_total{provider=~\"$provider\",model=~\"$model\"}[5m])) * 60)",
          "legendFormat": "{{provider}} / {{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    }
  ]
}

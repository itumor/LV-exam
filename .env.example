# Copy to .env and fill in DEV values only. Never put production secrets here.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_300=
STRIPE_PRICE_EXAM_PASS=
AUTH_DB_PATH=./data/auth.sqlite3
BILLING_DB_PATH=./data/billing.sqlite3
PORT=4173
APP_ENV=development
# T-046: voice STT (defaults to Groq Whisper; reuses GROQ_API_KEY)
# Override the STT model with LVCODEX_VOICE_MODEL=whisper-large-v3-turbo
# Switch to OpenAI Whisper with LVCODEX_VOICE_PROVIDER=openai + OPENAI_API_KEY
# Set LVCODEX_VOICE_FAKE_TRANSCRIPT=... in tests / dev to skip the network call.
LVCODEX_VOICE_PROVIDER=groq
LVCODEX_VOICE_LANGUAGE=lv


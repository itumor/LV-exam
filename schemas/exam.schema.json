{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itumor/LV-exam/schemas/exam.schema.json",
  "title": "Latvian Exam Manifest",
  "description": "JSON Schema (Draft 2020-12) for exam manifests produced by exam_bank.import_exam_markdown(). Enforces structural integrity of exams that ship to learners: required identity fields, level enum, and per-level section/scoring rules. CEFR levels (A2/B1/B2) require four skill sections (listening/reading/writing/speaking) at 15 points each with per-level minimum-per-skill thresholds (A2=9, B1=12, B2=15). The CITIZENSHIP level (T-071, Latvian naturalisation exam) uses a different shape: three sections (history, constitution, language) with a dual-section pass rule.",
  "type": "object",
  "required": [
    "schema_version",
    "exam_id",
    "title",
    "level",
    "language",
    "status",
    "content_version",
    "scoring",
    "sections"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {"properties": {"level": {"const": "A2"}}, "required": ["level"]},
      "then": {
        "properties": {
          "scoring": {
            "required": ["skill_points", "minimum_per_skill"],
            "properties": {
              "total_points": {"const": 60},
              "minimum_per_skill": {"const": 9}
            }
          },
          "sections": {"minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/cefr_section"}}
        }
      }
    },
    {
      "if": {"properties": {"level": {"const": "B1"}}, "required": ["level"]},
      "then": {
        "properties": {
          "scoring": {
            "required": ["skill_points", "minimum_per_skill"],
            "properties": {
              "total_points": {"const": 60},
              "minimum_per_skill": {"const": 12}
            }
          },
          "sections": {"minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/cefr_section"}}
        }
      }
    },
    {
      "if": {"properties": {"level": {"const": "B2"}}, "required": ["level"]},
      "then": {
        "properties": {
          "scoring": {
            "required": ["skill_points", "minimum_per_skill"],
            "properties": {
              "total_points": {"const": 60},
              "minimum_per_skill": {"const": 15}
            }
          },
          "sections": {"minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/cefr_section"}}
        }
      }
    },
    {
      "if": {"properties": {"level": {"const": "CITIZENSHIP"}}, "required": ["level"]},
      "then": {
        "properties": {
          "scoring": {
            "required": ["section_points", "minimum_per_section"],
            "properties": {
              "total_points": {"const": 35},
              "section_points": {
                "type": "object",
                "required": ["history", "constitution", "language"],
                "additionalProperties": false,
                "properties": {
                  "history":      {"type": "integer", "const": 10},
                  "constitution": {"type": "integer", "const": 10},
                  "language":     {"type": "integer", "const": 15}
                }
              },
              "minimum_per_section": {
                "type": "object",
                "required": ["history_constitution_combined", "language"],
                "additionalProperties": false,
                "properties": {
                  "history_constitution_combined": {"type": "integer", "minimum": 1, "maximum": 20},
                  "language": {"type": "integer", "minimum": 1, "maximum": 15}
                }
              }
            }
          },
          "sections": {"minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/citizenship_section"}}
        }
      }
    }
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "description": "Manifest schema version. Currently '1.0'."},
    "version": {"type": "string", "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])\\.[0-9]+$", "description": "T-037 semantic content version in calendar-versioned YYYY.MM.N format. Optional."},
    "exam_id": {"type": "string", "minLength": 1, "description": "Stable identifier for the exam."},
    "slug": {"type": "string", "description": "URL-safe slug derived from exam_id."},
    "title": {"type": "string", "minLength": 1},
    "level": {
      "type": "string",
      "enum": ["A2", "B1", "B2", "CITIZENSHIP"],
      "description": "Exam level. A2/B1/B2 are CEFR; CITIZENSHIP is the Latvian naturalisation exam (T-071)."
    },
    "language": {"type": "string", "minLength": 2, "description": "ISO 639-1 language code, e.g. 'lv'."},
    "status": {"type": "string", "enum": ["draft", "review", "published", "archived"]},
    "content_version": {"type": "integer", "minimum": 1},
    "is_immutable": {"type": "boolean"},
    "source": {"type": "object", "additionalProperties": true},
    "workflow": {"type": "object", "additionalProperties": true},
    "scoring": {
      "type": "object",
      "required": ["total_points"],
      "additionalProperties": true,
      "properties": {
        "total_points": {"type": "integer", "minimum": 1, "description": "Sum of all section/skill points. CEFR=60, CITIZENSHIP=35."},
        "skill_points": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "listening": {"type": "integer", "const": 15},
            "reading":   {"type": "integer", "const": 15},
            "writing":   {"type": "integer", "const": 15},
            "speaking":  {"type": "integer", "const": 15}
          },
          "description": "CEFR per-skill totals. Omitted for CITIZENSHIP."
        },
        "section_points": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "history":      {"type": "integer", "minimum": 1},
            "constitution": {"type": "integer", "minimum": 1},
            "language":     {"type": "integer", "minimum": 1}
          },
          "description": "CITIZENSHIP per-section totals (T-071)."
        },
        "minimum_per_skill": {
          "type": "integer",
          "enum": [9, 12, 15],
          "description": "CEFR per-level pass threshold. Pinned per level by allOf."
        },
        "minimum_per_section": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "history_constitution_combined": {"type": "integer", "minimum": 1},
            "language": {"type": "integer", "minimum": 1}
          },
          "description": "CITIZENSHIP dual-section pass thresholds (T-071)."
        },
        "task_point_allocation": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 1}
          }
        },
        "pass_rule": {"type": "object", "additionalProperties": true}
      }
    },
    "assets": {"type": "object", "additionalProperties": true},
    "sections": {
      "type": "array",
      "description": "Exam sections. CEFR exams require 4 (listening/reading/writing/speaking); CITIZENSHIP requires 3 (history/constitution/language).",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    },
    "answer_key": {"type": "object", "additionalProperties": true},
    "references": {"type": "object", "additionalProperties": true},
    "validation": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["skill", "title", "points_max", "tasks"],
      "additionalProperties": true,
      "properties": {
        "skill": {
          "type": "string",
          "enum": ["listening", "reading", "writing", "speaking", "history", "constitution", "language"]
        },
        "title": {"type": "string", "minLength": 1},
        "points_max": {"type": "integer", "minimum": 1},
        "minutes": {"type": "integer", "minimum": 1},
        "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
      }
    },
    "cefr_section": {
      "allOf": [
        {"$ref": "#/$defs/section"},
        {
          "properties": {
            "skill": {"type": "string", "enum": ["listening", "reading", "writing", "speaking"]},
            "points_max": {"type": "integer", "const": 15}
          }
        }
      ]
    },
    "citizenship_section": {
      "allOf": [
        {"$ref": "#/$defs/section"},
        {
          "properties": {
            "skill": {"type": "string", "enum": ["history", "constitution", "language"]},
            "points_max": {"type": "integer", "enum": [10, 15]}
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "required": ["task_key", "points_max", "scoring_mode"],
      "additionalProperties": true,
      "properties": {
        "task_key": {"type": "string", "pattern": "^task[0-9]+$"},
        "title": {"type": "string"},
        "type": {"type": "string"},
        "task_type": {"type": "string"},
        "scoring_mode": {"type": "string", "enum": ["objective", "subjective", "mixed"]},
        "points_max": {"type": "integer", "minimum": 1, "maximum": 15},
        "instruction": {"type": "string"},
        "prompt": {"type": "string"},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
        "audio_assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
        "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
        "choices": {"type": "array", "items": {"type": "object"}},
        "requirements": {"type": "array", "items": {"type": "string"}}
      }
    },
    "asset": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": true,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "kind": {"type": "string"}
      }
    },
    "question": {
      "type": "object",
      "required": ["number", "kind"],
      "additionalProperties": true,
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "prompt": {"type": "string"},
        "passage": {"type": "string"},
        "kind": {"type": "string", "minLength": 1},
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "text"],
            "additionalProperties": true,
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "text": {"type": "string"}
            }
          }
        },
        "correct_answer": {"type": ["string", "number", "boolean", "null"]},
        "correct_answers": {"type": "array", "items": {"type": ["string", "number", "boolean"]}},
        "image": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/asset"}]},
        "lemma": {"type": "string"},
        "required_sentence_count": {"type": "integer", "minimum": 1},
        "minimum_words": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"enum": ["objective", "multiple_choice", "true_false", "matching", "gap_fill", "reading_text_choice", "inflection"]}},
            "required": ["kind"]
          },
          "then": {
            "required": ["correct_answers"],
            "properties": {"correct_answers": {"type": "array", "minItems": 1}}
          }
        }
      ]
    }
  }
}
